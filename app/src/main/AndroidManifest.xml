<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">


    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.NOTIFICATION_POLICY_CONTROL" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Speaking tier: record the user's pronunciation for self-comparison. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        tools:targetApi="31">
        <!-- Required by LiteRT-LM's GPU backend (OpenCL acceleration via
             vendor libraries). Without these, GPU init fails and we fall back
             to CPU — which still works but defeats the purpose of picking
             Gemma 4. android:required="false" so the app still installs on
             devices that lack these libs. -->
        <uses-native-library android:name="libvndksupport.so" android:required="false"/>
        <uses-native-library android:name="libOpenCL.so" android:required="false"/>
        <service
            android:name=".service.MyForegroundService"
            android:foregroundServiceType="specialUse"
            android:enabled="true"
            android:exported="false">
            <!-- Required by Play Console for any specialUse FGS targeting API 34+:
                 declare why none of the typed FGS categories fit. This service
                 surfaces a passively-glanceable vocab word in the notification
                 shade — not media, not data sync, not location, not a connected
                 device. The user opted in via the install/notification grant,
                 the cadence is 30s (battery-friendly), and the work doesn't
                 belong in any of the typed FGS buckets. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="passive_vocab_glance_notification" />
        </service>
        <receiver
            android:name=".streak.StreakReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".streak.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".onboarding.OnboardingActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MyApplication.Onboarding" />
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".wordlist.WordListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".quiz.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>