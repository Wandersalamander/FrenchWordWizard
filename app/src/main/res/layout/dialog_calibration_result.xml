<?xml version="1.0" encoding="utf-8"?>
<!-- Post-assessment placement dialog. A small celebratory payoff after the
     level check: a headline, the level the user was placed at (big monospace
     number in the mastery-green, matching the lifetime bar), a one-line
     explanation, and a single green "go" button that dismisses and hands off
     to the tutorial / first round. Centered, light/dark-adaptive. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="26dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/calResultEmoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:text="🎉"
        android:textSize="44sp" />

    <TextView
        android:id="@+id/calResultHeadline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:text="Nicely done!" />

    <TextView
        style="@style/CardEyebrow"
        android:layout_width="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="YOUR PLACEMENT" />

    <TextView
        android:id="@+id/calResultLevel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textColor="@color/seg_mastered"
        android:textSize="38sp"
        android:textStyle="bold"
        tools:text="Level 4 / 11" />

    <TextView
        android:id="@+id/calResultSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:lineSpacingExtra="2sp"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp"
        tools:text="You already know words up to here. We'll start around this level and adapt as you go." />

    <TextView
        android:id="@+id/calResultButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_onb_cta"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="monospace"
        android:gravity="center"
        android:minHeight="52dp"
        android:paddingVertical="14dp"
        android:text="Start learning  →"
        android:textColor="@color/monokai_bg"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>
