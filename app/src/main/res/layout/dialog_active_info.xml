<?xml version="1.0" encoding="utf-8"?>
<!-- Explainer for the ACTIVE WORDS card. Mirrors dialog_streak_info /
     dialog_score_info: hero emoji + title + subtitle + iconified bullets that
     decode the three numbers ("{read}  ·  {listen}  ·  {invert}"), one per skill
     in the unlock ladder. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="28dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@null"
        android:text="🎯"
        android:textSize="56sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:accessibilityHeading="true"
        android:text="Active words"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:text="What you're drilling right now, by skill"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp" />

    <!-- ============ WHAT THE THREE NUMBERS MEAN ============
         A colour-matched mini-table: each (illustrative) number sits above its
         skill in the SAME colour the live card label and the bar segment use
         (seg_read / seg_listen / seg_invert), so the colour ties each number to
         its skill at a glance. Keep these colours in sync with
         ProgressBars.buildActiveLabel / Skill.accentColorRes. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:id="@+id/activeInfoRead"
                android:textColor="@color/seg_read"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:text="8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Reading"
                android:textColor="@color/seg_read"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:id="@+id/activeInfoListen"
                android:textColor="@color/seg_listen"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:text="5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Listening"
                android:textColor="@color/seg_listen"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:id="@+id/activeInfoInvert"
                android:textColor="@color/seg_invert"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:text="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Recall"
                android:textColor="@color/seg_invert"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:lineSpacingExtra="2sp"
        android:text="Words you're drilling right now. Each skill unlocks the next: master Reading, then Listening, then Recall."
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp" />

    <!-- The optional per-skill "finished today" count: a skill renders a second
         number after its active count (e.g. "8 2"), the today-count in gold
         (today_count_color). Shown here as its own mini-example. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:id="@+id/activeInfoTodayActive"
            android:textColor="@color/seg_read"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:id="@+id/activeInfoTodayGold"
            android:textColor="@color/today_count_color"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text=" 2" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:lineSpacingExtra="2sp"
            android:text="A second number after a skill is how many you finished there today."
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ===================== AUTO-ADD THRESHOLD =====================
         The per-language "active pool" floor, surfaced on the very card that
         shows the pool so it can be tuned in context (also lives in
         Settings → Active pool). Wired in ProgressCardInfoView; scoped to the
         current language. Uses a READ-orange keycap + digits (seg_read) — the
         pool feeds the reading rotation, so it reads as part of the orange READ
         family; the Settings → Active pool stepper keeps its own yellow styling. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="22dp"
        android:background="?android:attr/listDivider" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:accessibilityHeading="true"
        android:text="Words to learn at once"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:lineSpacingExtra="2sp"
        android:text="When you drop below this many words in progress, a fresh one joins in (per language)."
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/activeThresholdDecrease"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_stepper_button_read"
            android:clickable="true"
            android:contentDescription="Fewer words at once"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/seg_read"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/activeThresholdValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:fontFamily="monospace"
            android:gravity="center"
            android:textColor="@color/seg_read"
            android:textSize="56sp"
            android:textStyle="bold"
            tools:text="5" />

        <TextView
            android:id="@+id/activeThresholdIncrease"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_stepper_button_read"
            android:clickable="true"
            android:contentDescription="More words at once"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/seg_read"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        style="@style/CardEyebrow"
        android:layout_width="match_parent"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="WORDS AT ONCE · 1–40" />
</LinearLayout>
</ScrollView>
