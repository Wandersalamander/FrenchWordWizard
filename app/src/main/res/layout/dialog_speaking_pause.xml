<?xml version="1.0" encoding="utf-8"?>
<!-- "Can't speak" pause picker for the Speaking tier (the repurposed Hint
     button). Two stepper rows — hours and minutes — in the same cream-tuned
     keycap + olive-mustard digit style as the active-pool setup dialog, with a
     green CTA that saves the deadline and drops Speaking out of rotation until
     it passes. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@null"
            android:text="🎤"
            android:textSize="48sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:text="Pause speaking"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="2sp"
            android:text="How long should we hold off on speaking practice? Other exercises keep going."
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp" />

        <!-- ───────────────── Hours ───────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pauseHoursDecrease"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_stepper_button_yellow"
                android:clickable="true"
                android:contentDescription="Fewer hours"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="−"
                android:textColor="@color/auto_add_color"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pauseHoursValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="@color/auto_add_color"
                android:textSize="48sp"
                android:textStyle="bold"
                tools:text="1" />

            <TextView
                android:id="@+id/pauseHoursIncrease"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_stepper_button_yellow"
                android:clickable="true"
                android:contentDescription="More hours"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/auto_add_color"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            style="@style/CardEyebrow"
            android:layout_width="match_parent"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="HOURS" />

        <!-- ───────────────── Minutes ───────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pauseMinutesDecrease"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_stepper_button_yellow"
                android:clickable="true"
                android:contentDescription="Fewer minutes"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="−"
                android:textColor="@color/auto_add_color"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pauseMinutesValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="@color/auto_add_color"
                android:textSize="48sp"
                android:textStyle="bold"
                tools:text="0" />

            <TextView
                android:id="@+id/pauseMinutesIncrease"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_stepper_button_yellow"
                android:clickable="true"
                android:contentDescription="More minutes"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/auto_add_color"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            style="@style/CardEyebrow"
            android:layout_width="match_parent"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="MINUTES · STEP 5" />

        <TextView
            android:id="@+id/pauseSpeakingButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_onb_cta"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:minHeight="52dp"
            android:paddingVertical="14dp"
            android:text="Pause speaking  →"
            android:textColor="@color/monokai_bg"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
