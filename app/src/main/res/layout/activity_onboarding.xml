<?xml version="1.0" encoding="utf-8"?>
<!-- First-run setup, themed as the code editor the rest of the app lives in:
     a dark Monokai canvas you "fill in" like a config file. Monospace
     throughout; section labels read as // comments; the language is a cyan
     value, the word count a yellow number, and the commit button a green
     run/execute action. ScrollView so the whole config fits on short screens
     and at large font scales. Entrance is staggered in OnboardingActivity. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/onbScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_onb_root"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/onbRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <!-- ============================ HEADER ============================ -->
        <!-- Editor "breadcrumb" so the screen frames itself as a file you're
             editing rather than a generic welcome card. -->
        <TextView
            android:id="@+id/onbCrumb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:text="~/vocab · first run"
            android:textColor="@color/monokai_comment_light"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/onbTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:accessibilityHeading="true"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2sp"
            android:text="Set up\nyour studies."
            android:textColor="@color/monokai_fg"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/onbSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="3sp"
            android:text="Two choices and you're in. A quick level check comes next, then you start learning."
            android:textColor="@color/monokai_comment_light"
            android:textSize="14sp" />

        <!-- ======================= 1 · LANGUAGE ======================= -->
        <TextView
            android:id="@+id/onbLangHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:accessibilityHeading="true"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            android:text="// 1 — language"
            android:textColor="@color/monokai_pink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Populated in code from Language.values() with inflated
             item_onb_language rows. -->
        <LinearLayout
            android:id="@+id/onbLanguageList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />

        <!-- ===================== 2 · WORDS IN ROTATION ===================== -->
        <TextView
            android:id="@+id/onbPoolHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:accessibilityHeading="true"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            android:text="// 2 — words in rotation"
            android:textColor="@color/monokai_pink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/onbPoolDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="3sp"
            android:text="How many words you're actively learning at once. A fresh word is pulled in whenever you dip below this. Start small — you can raise it any time in Settings."
            android:textColor="@color/monokai_comment_light"
            android:textSize="14sp" />

        <!-- Stepper: yellow keycap ± flanking a big yellow number, matching the
             Active-pool control in Settings but on the dark canvas. -->
        <LinearLayout
            android:id="@+id/onbStepperRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/onbPoolDecrease"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_onb_stepper"
                android:clickable="true"
                android:contentDescription="Fewer words in rotation"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="−"
                android:textColor="@color/monokai_yellow"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/onbPoolValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="@color/monokai_yellow"
                android:textSize="60sp"
                android:textStyle="bold"
                tools:text="5" />

            <TextView
                android:id="@+id/onbPoolIncrease"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_onb_stepper"
                android:clickable="true"
                android:contentDescription="More words in rotation"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/monokai_yellow"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/onbPoolCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.15"
            android:text="WORDS AT ONCE · 1–40"
            android:textColor="@color/monokai_comment"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- ============================ COMMIT ============================ -->
        <TextView
            android:id="@+id/onbBegin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:background="@drawable/bg_onb_cta"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:minHeight="56dp"
            android:paddingVertical="16dp"
            android:text="▸  run setup"
            android:textColor="@color/monokai_bg"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/onbFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="Everything here is editable later in Settings."
            android:textColor="@color/monokai_comment"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
