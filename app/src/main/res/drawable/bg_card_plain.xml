<?xml version="1.0" encoding="utf-8"?>
<!-- Plain card: same lifted-surface chrome as the colored cards (card_surface
     fill + olive-comment hairline edge) but without the 3dp accent stripe.
     Used for utility containers (e.g. the Word List filter row) that should
     read as panels without claiming a Monokai accent of their own. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="14dp" />
    <solid android:color="@color/card_surface" />
    <stroke android:width="1dp" android:color="@color/card_edge" />
</shape>
