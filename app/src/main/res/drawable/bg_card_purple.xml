<?xml version="1.0" encoding="utf-8"?>
<!-- Purple accent card. Used by the Settings "Reset progress" section — purple
     is the one Monokai accent not in use on the main quiz screen, so it gives
     destructive settings their own visual identity without compromising the
     four-stripe palette (orange/pink/green/cyan) of the quiz. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/card_surface" />
            <stroke android:width="1dp" android:color="@color/card_edge" />
        </shape>
    </item>
    <item android:height="3dp" android:gravity="top">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="14dp"
                android:topRightRadius="14dp" />
            <solid android:color="@color/monokai_purple" />
        </shape>
    </item>
</layer-list>
