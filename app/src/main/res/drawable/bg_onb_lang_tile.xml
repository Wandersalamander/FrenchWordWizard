<?xml version="1.0" encoding="utf-8"?>
<!-- Selectable language tile. Reads as a syntax-highlighted value you're
     assigning: unselected is a quiet raised editor row (the card surface + an
     olive hairline); selected keeps the same surface but gains a cyan keyword
     border and ● marker — cyan is the value/identifier accent in the Monokai
     system, so the chosen language "highlights" like a selected token. Colours
     are the shared mode-aware palette tokens (card_surface / card_edge /
     progress_track, and seg_listen — the app's display-safe cyan), so the tile
     tracks light and dark with the rest of the app. Toggled via View.isSelected
     in OnboardingActivity. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/card_surface" />
            <stroke android:width="2dp" android:color="@color/seg_listen" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/progress_track" />
            <stroke android:width="1dp" android:color="@color/card_edge" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/card_surface" />
            <stroke android:width="1dp" android:color="@color/card_edge" />
        </shape>
    </item>
</selector>
