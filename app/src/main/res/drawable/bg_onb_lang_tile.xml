<?xml version="1.0" encoding="utf-8"?>
<!-- Selectable language tile. Reads as a syntax-highlighted value you're
     assigning: unselected is a quiet raised editor row (bg_lift + olive
     hairline); selected lights up with a cyan keyword border and a faint cyan
     wash — cyan is the value/identifier accent in the Monokai system, so the
     chosen language literally "highlights" like a selected token. Toggled via
     View.isSelected in OnboardingActivity. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#1A66D9EF" />
            <stroke android:width="2dp" android:color="@color/monokai_cyan" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#0FFFFFFF" />
            <stroke android:width="1dp" android:color="@color/monokai_comment" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/monokai_bg_lift" />
            <stroke android:width="1dp" android:color="#4D75715E" />
        </shape>
    </item>
</selector>
