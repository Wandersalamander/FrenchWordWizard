<?xml version="1.0" encoding="utf-8"?>
<!-- READ-orange keycap-style stepper button for the "fresh words pool" control
     in the ACTIVE WORDS dialog. Same soft key-cap silhouette as
     bg_stepper_button_yellow (rounded 10dp square, 1.5dp outline, translucent
     fill, low-alpha press highlight) but outlined in the READ accent (seg_read):
     the pool sets how many words enter the READING rotation, so it reads as part
     of the orange READ family rather than a stray gold. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#33FD971F" />
            <stroke android:width="1.5dp" android:color="@color/seg_read" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/seg_read" />
        </shape>
    </item>
</selector>
