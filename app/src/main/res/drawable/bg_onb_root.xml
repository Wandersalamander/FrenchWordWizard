<?xml version="1.0" encoding="utf-8"?>
<!-- First-run canvas: the themed window background as a flat fill — cream paper
     in light, the Monokai editor canvas in dark — so the first-run screen uses
     exactly the same surface colour as every other screen. (Previously a bespoke
     dark gradient; flattened to the shared palette for consistency.) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?android:attr/colorBackground" />
</shape>
