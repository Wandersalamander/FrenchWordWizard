<resources>
    <!-- Light mode: Monokai pink/cyan accents on a warm cream canvas, with the
         action bar pinned to Monokai BG so the top of the screen reads as
         editor chrome regardless of the system theme. -->
    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Iconic pink for primary actions: NEXT, dialog confirm, switches.
             Uses monokai_pink_dark (not the brighter monokai_pink) so white-
             on-pink button labels clear 4.5:1 against the cream surface;
             the brighter shade only managed ~3.8:1 and tripped WCAG 1.4.3.
             Card stripes and other decorative chrome still reference
             @color/monokai_pink directly. -->
        <item name="colorPrimary">@color/monokai_pink_dark</item>
        <item name="colorPrimaryVariant">@color/monokai_pink_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Cyan secondary for FAB / accent components. -->
        <item name="colorSecondary">@color/monokai_cyan</item>
        <item name="colorSecondaryVariant">@color/monokai_cyan_dark</item>
        <item name="colorOnSecondary">@color/monokai_bg</item>
        <item name="colorAccent">@color/monokai_cyan</item>

        <!-- Cream paper surface, pure black for body copy. Monokai BG (#272822)
             reads as olive-tinted gray on cream rather than crisp black, so we
             push primary text to true black for legibility; only the muted
             secondary/tertiary tiers carry the Monokai olive warmth. -->
        <item name="android:colorBackground">@color/cream_surface</item>
        <item name="colorSurface">@color/cream_surface</item>
        <item name="colorOnSurface">@color/black</item>

        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/monokai_comment</item>
        <item name="android:textColorTertiary">@color/monokai_comment_light</item>

        <!-- Top bar (status + action bar) follows the system theme: a light
             cream bar with dark content in light mode (the night variant keeps
             the dark Monokai bar). windowLightStatusBar=true darkens the
             status-bar icons so they read on cream; actionBarTheme overrides the
             always-light content the DarkActionBar parent would otherwise force. -->
        <item name="actionBarStyle">@style/Widget.MyApplication.ActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.MyApplication.ActionBar</item>
        <item name="android:statusBarColor">@color/top_bar_bg</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- De-stock the standard controls so they read as part of the app
             rather than default Android: the popups + action-bar overflow sit on
             a themed surface, and buttons drop the heavy ALL-CAPS Material look. -->
        <item name="popupMenuStyle">@style/Widget.MyApplication.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.MyApplication.PopupMenu.Overflow</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.MyApplication.Popup</item>
        <item name="materialButtonStyle">@style/Widget.MyApplication.Button</item>
    </style>

    <!-- First-run setup screen. No action bar (full-bleed editor canvas); the
         window background, status bar, and icon tint all follow the system
         theme via the parent — cream paper in light, the Monokai canvas in dark
         — so the setup matches the rest of the app instead of being hardwired
         dark. -->
    <style name="Theme.MyApplication.Onboarding" parent="Theme.MyApplication">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>

    <style name="Widget.MyApplication.ActionBar" parent="Widget.AppCompat.ActionBar.Solid">
        <item name="background">@color/top_bar_bg</item>
        <item name="elevation">2dp</item>
    </style>

    <!-- Action bar title + overflow/back icons follow the theme via
         top_bar_content (dark on the light bar, light on the dark bar),
         overriding the always-light content the DarkActionBar parent forces.
         Applied only by the light theme; the night theme keeps the parent's
         dark-overlay (light content) on its dark bar. -->
    <style name="ThemeOverlay.MyApplication.ActionBar" parent="">
        <item name="android:textColorPrimary">@color/top_bar_content</item>
        <item name="colorControlNormal">@color/top_bar_content</item>
    </style>

    <!-- IDE-style section eyebrow used above the data inside the three small
         cards (Streak / Total Progress / Active Words). Small, monospace,
         widely-tracked uppercase in @color/card_eyebrow — a mode-aware token
         (darker on cream, lighter on bg_lift) that clears WCAG 4.5:1 in
         both themes. The previous monokai_comment_light hex only managed
         ~2.6:1 on the light card. -->
    <style name="CardEyebrow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/card_eyebrow</item>
    </style>

    <!-- Popups (the ⋮ overflow and the language picker) on the app's own surface
         — a rounded card_surface pane with the same olive hairline as the cards —
         instead of the default white/grey Android popup. -->
    <style name="Widget.MyApplication.PopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup</item>
    </style>

    <style name="Widget.MyApplication.PopupMenu.Overflow" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/bg_popup</item>
        <item name="android:overlapAnchor">true</item>
    </style>

    <!-- Makes the action-bar overflow popup follow the app surface + text in BOTH
         modes. The DarkActionBar parent otherwise forces a light popup, which
         looks stock in light mode and would go dark-on-dark once the background
         is themed in night mode. card_surface and vocab_text are both mode-aware,
         so text stays readable on the surface either way. -->
    <style name="ThemeOverlay.MyApplication.Popup" parent="ThemeOverlay.AppCompat">
        <item name="android:colorBackground">@color/card_surface</item>
        <item name="colorSurface">@color/card_surface</item>
        <item name="android:textColorPrimary">@color/vocab_text</item>
    </style>

    <!-- App buttons: keep the pink fill but drop the heavy stock-Material look —
         no ALL-CAPS, flat (no elevation), and rounded to match the editor chrome.
         Buttons with their own style (the ⚑/✓ icon buttons) or explicit tint
         (the danger Reset button) keep their overrides. -->
    <style name="Widget.MyApplication.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
    </style>
</resources>
