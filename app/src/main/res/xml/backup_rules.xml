<?xml version="1.0" encoding="utf-8"?><!--
   Pre-Android-12 Auto Backup rules. The Room database is excluded so we
   keep ownership of structured sync (see ADR-001) — Auto Backup of a live
   SQLite file can ship a half-written page. SharedPreferences still rides
   along because (a) the small UI-settings in AppPrefs are fine to restore
   as-is, and (b) the legacy per-vocab keys still in the file act as the
   seed source for the one-shot LegacyImporter if a user restores onto a
   device with an empty Room DB.
-->
<full-backup-content>
    <exclude domain="database" path="app.db"/>
    <exclude domain="database" path="app.db-shm"/>
    <exclude domain="database" path="app.db-wal"/>
</full-backup-content>
