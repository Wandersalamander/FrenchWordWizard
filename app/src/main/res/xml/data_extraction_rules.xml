<?xml version="1.0" encoding="utf-8"?><!--
   Android 12+ backup / device-transfer rules. The Room database is excluded
   from cloud backup so we keep structured sync under our own control (see
   ADR-001). SharedPreferences is included by default, which is what we want
   — the legacy per-vocab keys still in the file act as the seed source for
   the one-shot LegacyImporter when restored onto a device with an empty
   Room DB.

   The device-transfer block is left to defaults — direct phone-to-phone
   transfers can include the Room DB (the source device's WAL is consistent
   when the transfer runs, unlike a cloud snapshot).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="app.db"/>
        <exclude domain="database" path="app.db-shm"/>
        <exclude domain="database" path="app.db-wal"/>
    </cloud-backup>
</data-extraction-rules>
